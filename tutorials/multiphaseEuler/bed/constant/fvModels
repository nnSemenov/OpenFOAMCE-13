FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      fvModels;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

massSource
{
    type            massSource;

    phase           water;

    cellZone
    {
        type            containsPoints;
        points          ((0.075 0.925 0.05));
    }

    massFlowRate
    {
        type            square;
        amplitude       0.5;
        frequency       0.5;
        level           0.5;
        markSpace       0.3333;
    }
}

capillaryForce {
    type capillaryForce;
    libs ("libmultiphaseEulerFvModels.so");

    referencePhase air;
    capillaryPressure {
        air_to_water {
            type LeverettJ;

            // theta ...
            solids (solid);
            liquid water;

            J0 0.48;
            beta 0.036;

            E1 180;
        }
    }
}
